# Never commit actual keys. Not required by tests or doctor:probe.
# Paid runner requires this exact opt-in value:
ALSP_ENABLE_MAINNET=
ALSP_PRIVATE_KEY=
# Independently review Doctor's published signer; do not silently trust-on-first-use.
ALSP_RECEIPT_SIGNER=
ALSP_RPC_URL=https://mainnet.base.org

# Web client / Vercel deployment (demo/server.mjs, api/index.js). Optional.
# Comma-separated provider origins the stateless proxy may forward payments to; empty = any public HTTPS origin.
ALSP_ALLOWED_ORIGINS=
# Agent page (public/agent.html). The server only relays one model turn at a time; keys never reach the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Central run logs (public/logs.html, /api/logs). Connecting a Vercel Blob store to the project sets BLOB_STORE_ID (OIDC auth)
# or BLOB_READ_WRITE_TOKEN; locally logs go to data/logs/. ALSP_LOG_ACCESS=private if the store is private (auto-detected otherwise).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Optional: require this token in POST /api/logs bodies ({ token }) to publish.
ALSP_LOG_TOKEN=
