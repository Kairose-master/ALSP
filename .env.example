# Never commit actual keys. Not required by tests or doctor:probe.
# Paid runner requires this exact opt-in value:
ALSP_ENABLE_MAINNET=
ALSP_PRIVATE_KEY=
# Independently review Doctor's published signer; do not silently trust-on-first-use.
ALSP_RECEIPT_SIGNER=
ALSP_RPC_URL=https://mainnet.base.org

# Web client / Vercel deployment (demo/server.mjs, api/index.js). Optional.
# Comma-separated provider origins the stateless proxy may forward payments to; empty = any public HTTPS origin.
ALSP_ALLOWED_ORIGINS=
