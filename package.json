{
  "name": "alsp-reference",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "doctor:probe": "npm run build --silent && node examples/doctor/doctor.mjs probe",
    "doctor:paid": "npm run build --silent && node examples/doctor/doctor.mjs paid",
    "doctor:reconcile": "npm run build --silent && node examples/doctor/doctor.mjs reconcile",
    "demo": "npm run build --silent && node demo/server.mjs",
    "vercel-build": "npm run build",
    "build:vendor": "esbuild demo/vendor-entry.mjs --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=public/vendor/viem.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@vercel/blob": "^2.8.1",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "esbuild": "^0.25.10",
    "typescript": "5.9.2"
  }
}
